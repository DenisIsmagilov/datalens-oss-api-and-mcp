# Выключатели: правка .env -> docker compose -f docker-compose.realprod.yaml up -d datalens-neuro
# (restart .env не перечитывает)
NEURO_ENABLED=true
NEURO_UI_ENABLED=false
NEURO_UI_TITLE=Нейроаналитик
NEURO_UI_ROLES=datalens.admin,datalens.editor
NEURO_UI_ORIGINS=http://127.0.0.1:8080
NEURO_UI_CONVERSATION_IDLE_HOURS=6
# PEM публичного ключа datalens-auth. На проде уже есть у datalens-ui, в пример значение не класть.
AUTH_TOKEN_PUBLIC_KEY=
NEURO_PORT=8396
# сервисный токен каналов (секрет): python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NEURO_API_TOKEN=
NEURO_DEFAULT_PACK=default
NEURO_PACKS_DIR=/packs
NEURO_DB_PATH=/data/neuro.sqlite
NEURO_TIMEZONE=Europe/Moscow
NEURO_HISTORY_MESSAGES=10
NEURO_MAX_ROUNDS=15
NEURO_DEADLINE_SEC=150
NEURO_FORMULA_ATTEMPTS=3
NEURO_FORMULA_DOC_FRAGMENTS=8
NEURO_FORMULA_DOC_CHARS=6000
NEURO_TOOL_RESULT_MAX_CHARS=12000
NEURO_CONVERSATION_TTL_DAYS=30
NEURO_RATE_LIMIT_PER_MIN=30
DATALENS_API_HOST=http://datalens-api:8393
DL_API_TOKEN=
# больше DATA_QUERY_TIMEOUT_SEC (60) у datalens-api
DATALENS_API_TIMEOUT_SEC=90
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_TIMEOUT_SEC=120
LLM_MAX_RETRIES=2
# только для scripts/eval.py
# NEURO_EVAL_URL=http://localhost:8396
# NEURO_EVAL_DIR=/data/eval
